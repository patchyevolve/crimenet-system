# Database Configuration
DATABASE_URL="postgresql://criminal:criminal_secret@localhost:5432/criminal_network_db?schema=public"

# pgvector Extension (required for face embeddings and semantic search)
# Enable after database creation: CREATE EXTENSION IF NOT EXISTS vector;

# Neo4j Configuration (for graph database)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="criminal_secret"

# MinIO/S3 Configuration (for evidence file storage)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="criminal"
S3_SECRET_KEY="criminal_secret"
S3_BUCKET_NAME="criminal-evidence"
S3_REGION="us-east-1"

# LLM Provider (optional)
# GROQ_API_KEY="your_groq_api_key"
# MISTRAL_API_KEY="your_mistral_api_key"

# Application
APP_ENV="development"
APP_DEBUG="true"